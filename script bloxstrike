---Feeds a widget's current value and every change into `fn`.
function xDTaraZ.UI.Feed(widget, fn)
    pcall(fn, widget.Value)
    widget:OnChanged(fn)
end

---Keybind + key mode for a feature toggle. AirFlow keybinds only fire on press, so Toggle / Hold / Always
---(the old library's key picker modes) are handled here. Backspace or Delete clears the key.
function xDTaraZ.UI.KeyBind(group, toggleIdx, keyIdx, defaultKey, defaultMode)
    local bind = { Toggle = toggleIdx, Mode = defaultMode or "Toggle" }
    bind.Key = group:CreateKeybind({
        Name = T("Keybind", "ปุ่มลัด"),
        CurrentKeybind = defaultKey ~= "None" and defaultKey or nil,
        Flag = keyIdx,
        OnChanged = function(key)
            if key == Enum.KeyCode.Backspace or key == Enum.KeyCode.Delete then
                task.defer(function() bind.Key:Set(nil, true) end)
            end
        end,
    })
    local mode = xDTaraZ.UI.Dropdown(group, toggleIdx .. "Mode", { Name = T("Key mode", "โหมดปุ่ม"), Options = { "Toggle", "Hold", "Always" }, Default = bind.Mode })
    mode:OnChanged(function(value) xDTaraZ.UI.SetKeyMode(bind, value) end)
    table.insert(xDTaraZ.UI.Binds, bind)
    return bind
end

function xDTaraZ.UI.SetKeyMode(bind, mode)
    if mode ~= "Toggle" and mode ~= "Hold" and mode ~= "Always" then return end
    bind.Mode = mode
    local widget = xDTaraZ.UI.Widgets[bind.Toggle]
    if not widget then return end
    if mode == "Always" then
        widget:SetValue(true)
    elseif mode == "Hold" then
        widget:SetValue(false)
    end
end

---Feature keys work even when the game also uses the key; never while typing or while rebinding.
function xDTaraZ.UI.OnKey(input, down)
    if input.UserInputType ~= Enum.UserInputType.Keyboard then return end
    if down and UserInputService:GetFocusedTextBox() then return end
    local window = xDTaraZ.UI.Window
    local consumed = window ~= nil and window._consumedKey == input.KeyCode and osClock() - (window._consumedAt or 0) < 0.25
    for _, bind in ipairs(xDTaraZ.UI.Binds) do
        local ok, key = pcall(bind.Key.Get, bind.Key)
        if not ok or key == nil or key ~= input.KeyCode or bind.Key.Listening then continue end
        local widget = xDTaraZ.UI.Widgets[bind.Toggle]
        if not widget then continue end
        if bind.Mode == "Hold" then
            if not (down and consumed) then widget:SetValue(down) end
        elseif bind.Mode == "Toggle" and down and not consumed then
            widget:SetValue(not widget.Value)
        end
    end
end

---Vetoes turning `idx` on and tells the player why.
local function Veto(idx, message)
    local widget = xDTaraZ.UI.Widgets[idx]
    if not widget then return end
    widget:AddGuard(function(value)
        if value ~= true then return true end
        local text = message()
        if not text then return true end
        xDTaraZ.UI.Notify("Sync group", text, 4, "Warning")
        task.defer(widget.SetValue, widget, false)
        return false
    end)
end

---Blocks a hook-only feature on executors that cannot run it.
function xDTaraZ.UI.NeedCap(idx, caps)
    local widget = xDTaraZ.UI.Widgets[idx]
    Veto(idx, function()
        if xDTaraZ.Compat.Has(caps) then return nil end
        local feature = widget and widget.Name or idx
        return T(feature .. " is not supported on this executor", feature .. " ใช้กับ executor นี้ไม่ได้")
    end)
end

---Blocks a feature for good (missing game module, unsupported executor).
function xDTaraZ.UI.Block(idx, reason)
    local widget = xDTaraZ.UI.Widgets[idx]
    if widget then widget.Blocked = reason end
    Veto(idx, function()
        return (widget and widget.Name or idx) .. ": " .. tostring(reason)
    end)
end

function xDTaraZ.UI.Bind(widget, key)
    local function Apply(value) xDTaraZ.Options[key] = value end
    Apply(widget.Value)
    widget:OnChanged(Apply)
end

