function SYNCBanner.Step(label)
    local now = os.clock()
    SYNCBanner.Done = math.min(SYNCBanner.Done + 1, SYNCBanner.Total)
    local filled = math.floor(SYNCBanner.Done / SYNCBanner.Total * 20 + 0.5)
    SYNCBanner.Print(string.format("[Sync group] [%s] %3d%%  %-24s +%dms",
        string.rep("#", filled) .. string.rep(".", 20 - filled),
        math.floor(SYNCBanner.Done / SYNCBanner.Total * 100), label, math.floor((now - SYNCBanner.Last) * 1000)))
    SYNCBanner.Last = now
end

