end

function xDTaraZ.Visuals.Destroy()
    local visuals = xDTaraZ.Visuals
    visuals.ClearAll()
    if visuals.Gui then pcall(visuals.Gui.Destroy, visuals.Gui) end
    visuals.Gui = nil
    visuals.Radar = { Dots = {} }
end

